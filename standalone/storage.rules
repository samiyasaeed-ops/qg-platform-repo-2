rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{fileId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 20 * 1024 * 1024;
    }
    // Nobody reads backups directly from the client — the saveBackup
    // Cloud Function and the /_blob resolver use the Admin SDK, which
    // bypasses these rules entirely.
    match /backups/{fileId} {
      allow read, write: if false;
    }
  }
}
